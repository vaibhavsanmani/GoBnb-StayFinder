<% layout("/layouts/boilerplate") %>

<style>
:root {
    --brand: #fe424d;
    --brand-dark: #e03540;
    --ink: #222;
    --muted: #717171;
    --line: #e6e6e6;
}

/* ---------- STICKY TOOLBAR ---------- */
.toolbar {
    position: sticky;
    top: 0;               /* change to your navbar height if the navbar is sticky */
    z-index: 20;
    background: #fff;
    padding: 12px 0 8px;
    border-bottom: 1px solid transparent;
    transition: border-color .2s, box-shadow .2s;
}
.toolbar.stuck {
    border-color: var(--line);
    box-shadow: 0 6px 16px rgba(0, 0, 0, .05);
}
.toolbar-inner {
    display: flex;
    align-items: center;
    gap: .75rem;
}

/* ---------- FILTER CHIPS ---------- */
.filters-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
}
/* fade edges so users know it scrolls */
.filters-wrap::after {
    content: "";
    position: absolute;
    right: 0; top: 0; bottom: 0;
    width: 36px;
    background: linear-gradient(to right, transparent, #fff);
    pointer-events: none;
}
#filters {
    display: flex;
    gap: 1.6rem;
    overflow-x: auto;
    padding: 4px 28px 8px 4px;
    scrollbar-width: none;
    scroll-behavior: smooth;
}
#filters::-webkit-scrollbar { display: none; }

.filter-item {
    flex-shrink: 0;
    text-align: center;
    color: var(--muted);
    opacity: .85;
    padding-bottom: 6px;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    transition: color .2s, opacity .2s, border-color .2s, transform .2s;
    user-select: none;
}
.filter-item i { font-size: 1.15rem; display: block; margin-bottom: 4px; }
.filter-item p { font-size: .72rem; font-weight: 600; margin: 0; white-space: nowrap; }
.filter-item:hover { opacity: 1; color: var(--ink); transform: translateY(-2px); }
.filter-item.active {
    opacity: 1;
    color: var(--ink);
    border-bottom-color: var(--ink);
}

/* ---------- SEARCH + TAX ---------- */
.search-box {
    position: relative;
    flex-shrink: 0;
}
.search-box input {
    border: 1px solid var(--line);
    border-radius: 50px;
    padding: 8px 14px 8px 36px;
    font-size: .85rem;
    width: 190px;
    outline: none;
    transition: width .25s, border-color .2s, box-shadow .2s;
}
.search-box input:focus {
    width: 240px;
    border-color: var(--ink);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, .06);
}
.search-box i {
    position: absolute;
    left: 13px; top: 50%;
    transform: translateY(-50%);
    font-size: .8rem;
    color: var(--muted);
}
.tax {
    flex-shrink: 0;
    border: 1px solid var(--line);
    border-radius: 50px;
    padding: 7px 14px;
    display: flex;
    align-items: center;
    white-space: nowrap;
    font-size: .85rem;
}
.tax .form-check { margin: 0; display: flex; align-items: center; gap: .5rem; }
.tax .form-check-input { margin: 0; cursor: pointer; }
.tax .form-check-input:checked {
    background-color: var(--brand);
    border-color: var(--brand);
}
.tax label { cursor: pointer; }

@media (max-width: 768px) {
    .toolbar-inner { flex-wrap: wrap; }
    .filters-wrap { order: 3; flex-basis: 100%; }
    .search-box { flex: 1; }
    .search-box input, .search-box input:focus { width: 100%; }
}

/* ---------- LISTING CARD ---------- */
.listing-link { text-decoration: none; color: inherit; display: block; }

.listing-col {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .5s ease, transform .5s ease;
}
.listing-col.visible { opacity: 1; transform: none; }
.listing-col.hidden { display: none; }

.listing-card {
    border: none;
    background: transparent;
}
.img-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    aspect-ratio: 4 / 3;
    background: linear-gradient(110deg, #ececec 30%, #f7f7f7 50%, #ececec 70%);
    background-size: 200% 100%;
    animation: shimmer 1.4s linear infinite;   /* skeleton while loading */
}
@keyframes shimmer { to { background-position-x: -200%; } }

.img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity .4s, transform .6s cubic-bezier(.2, .7, .2, 1);
}
.img-wrap img.loaded { opacity: 1; }
.listing-link:hover .img-wrap img { transform: scale(1.07); }

/* gradient so badges/hearts stay readable */
.img-wrap::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,.25), transparent 35%);
    pointer-events: none;
}

.badge-cat {
    position: absolute;
    top: 12px; left: 12px;
    z-index: 2;
    background: rgba(255, 255, 255, .95);
    color: var(--ink);
    font-size: .7rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 50px;
    text-transform: capitalize;
}

.wish-btn {
    position: absolute;
    top: 10px; right: 10px;
    z-index: 3;
    width: 34px; height: 34px;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, .25);
    backdrop-filter: blur(4px);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: transform .2s, background .2s;
}
.wish-btn:hover { transform: scale(1.15); background: rgba(0, 0, 0, .4); }
.wish-btn.active { background: #fff; color: var(--brand); }
.wish-btn.pop i { animation: pop .35s ease; }
@keyframes pop { 50% { transform: scale(1.5); } }

.card-body { padding: 12px 2px 0; }
.listing-title {
    font-weight: 600;
    font-size: .98rem;
    margin: 0 0 2px;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.listing-loc {
    color: var(--muted);
    font-size: .8rem;
    margin: 0 0 4px;
}
.listing-loc i { color: var(--brand); margin-right: 4px; }
.listing-desc {
    color: var(--muted);
    font-size: .82rem;
    margin: 0 0 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.listing-price { margin: 0; font-size: .95rem; }
.listing-price strong { font-weight: 700; }
.listing-price .per { color: var(--muted); font-size: .8rem; }
.tax-info {
    display: inline-block;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    color: var(--brand);
    font-size: .75rem;
    font-weight: 600;
    transition: max-width .35s ease, opacity .35s ease, margin .35s;
}
.show-tax .tax-info { max-width: 120px; opacity: 1; margin-left: 4px; }

/* ---------- EMPTY STATE ---------- */
#noResults {
    display: none;
    text-align: center;
    padding: 4rem 1rem;
    color: var(--muted);
}
#noResults i { font-size: 2.5rem; margin-bottom: 1rem; color: #ccc; }
#noResults button {
    border: 1px solid var(--ink);
    background: #fff;
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
    margin-top: .5rem;
}
#noResults button:hover { background: var(--ink); color: #fff; }

/* ---------- TOAST ---------- */
#toast {
    position: fixed;
    bottom: 24px; left: 50%;
    transform: translate(-50%, 80px);
    background: var(--ink);
    color: #fff;
    padding: 10px 20px;
    border-radius: 50px;
    font-size: .85rem;
    opacity: 0;
    transition: transform .3s, opacity .3s;
    z-index: 999;
    pointer-events: none;
}
#toast.show { transform: translate(-50%, 0); opacity: 1; }

@media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
    .listing-col { opacity: 1; transform: none; }
}
</style>

<!-- ================= TOOLBAR ================= -->
<div class="toolbar" id="toolbar">
    <div class="toolbar-inner">

        <div class="filters-wrap">
            <div id="filters">
                <div class="filter-item active" data-filter="all"><i class="fa-solid fa-compass"></i><p>All</p></div>
                <div class="filter-item" data-filter="trending"><i class="fa-solid fa-fire"></i><p>Trending</p></div>
                <div class="filter-item" data-filter="rooms"><i class="fa-solid fa-bed"></i><p>Rooms</p></div>
                <div class="filter-item" data-filter="cities"><i class="fa-solid fa-mountain-city"></i><p>Cities</p></div>
                <div class="filter-item" data-filter="mountains"><i class="fa-solid fa-mountain"></i><p>Mountains</p></div>
                <div class="filter-item" data-filter="castles"><i class="fa-brands fa-fort-awesome"></i><p>Castles</p></div>
                <div class="filter-item" data-filter="arctic"><i class="fa-solid fa-snowflake"></i><p>Arctic</p></div>
                <div class="filter-item" data-filter="camping"><i class="fa-solid fa-campground"></i><p>Camping</p></div>
                <div class="filter-item" data-filter="farms"><i class="fa-solid fa-cow"></i><p>Farms</p></div>
                <div class="filter-item" data-filter="pools"><i class="fa-solid fa-person-swimming"></i><p>Pools</p></div>
                <div class="filter-item" data-filter="boats"><i class="fa-solid fa-sailboat"></i><p>Boats</p></div>
            </div>
        </div>

        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" id="searchInput" placeholder="Search stays..." autocomplete="off">
        </div>

        <div class="tax">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="taxSwitch">
                <label class="form-check-label" for="taxSwitch">Show GST</label>
            </div>
        </div>

    </div>
</div>

<!-- ================= LISTINGS ================= -->
<div class="row g-4 row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 mt-2 mb-4" id="listingGrid">

<% for (let listing of allListings) { %>
    <div class="col listing-col"
         data-category="<%= (listing.category || '').toLowerCase() %>"
         data-search="<%= (listing.title + ' ' + (listing.location || '') + ' ' + (listing.country || '')).toLowerCase() %>">

        <a href="/listings/<%= listing._id %>" class="listing-link">
            <div class="card listing-card h-100">

                <div class="img-wrap">
                    <img src="<%= listing.image && listing.image.url ? listing.image.url : '/images/default.jpg' %>"
                         alt="<%= listing.title %>"
                         loading="lazy"
                         onerror="this.onerror=null; this.src='/images/default.jpg';">

                    <% if (listing.category) { %>
                        <span class="badge-cat"><%= listing.category %></span>
                    <% } %>

                    <button type="button" class="wish-btn" data-id="<%= listing._id %>" aria-label="Save to wishlist">
                        <i class="fa-regular fa-heart"></i>
                    </button>
                </div>

                <div class="card-body">
                    <h6 class="listing-title"><%= listing.title %></h6>

                    <% if (listing.location || listing.country) { %>
                        <p class="listing-loc">
                            <i class="fa-solid fa-location-dot"></i>
                            <%= [listing.location, listing.country].filter(Boolean).join(", ") %>
                        </p>
                    <% } %>

                    <p class="listing-desc"><%= listing.description %></p>

                    <p class="listing-price">
                        <% if (listing.price) { %>
                            <strong class="price-value" data-price="<%= listing.price %>">
                                &#8377;<%= listing.price.toLocaleString("en-IN") %>
                            </strong>
                            <span class="per">/ night</span>
                            <span class="tax-info">+18% GST</span>
                        <% } else { %>
                            <strong>N/A</strong>
                        <% } %>
                    </p>
                </div>

            </div>
        </a>
    </div>
<% } %>

</div>

<!-- EMPTY STATE -->
<div id="noResults">
    <i class="fa-solid fa-house-circle-xmark"></i>
    <h5>No stays found</h5>
    <p>Try a different category or search term.</p>
    <button type="button" id="resetFilters">Clear filters</button>
</div>

<div id="toast"></div>

<!-- ================= SCRIPT ================= -->
<script>
(function () {
    const grid       = document.getElementById("listingGrid");
    const cards      = Array.from(grid.querySelectorAll(".listing-col"));
    const chips      = document.querySelectorAll(".filter-item");
    const searchEl   = document.getElementById("searchInput");
    const taxSwitch  = document.getElementById("taxSwitch");
    const noResults  = document.getElementById("noResults");
    const toolbar    = document.getElementById("toolbar");
    const toastEl    = document.getElementById("toast");

    let activeFilter = "all";
    let query = "";

    /* ---------- toast ---------- */
    let toastTimer;
    function toast(msg) {
        toastEl.textContent = msg;
        toastEl.classList.add("show");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toastEl.classList.remove("show"), 1800);
    }

    /* ---------- reveal on scroll ---------- */
    const io = new IntersectionObserver((entries) => {
        entries.forEach((entry, i) => {
            if (entry.isIntersecting) {
                setTimeout(() => entry.target.classList.add("visible"), (i % 4) * 70);
                io.unobserve(entry.target);
            }
        });
    }, { threshold: 0.08 });
    cards.forEach(c => io.observe(c));

    /* ---------- image fade-in + stop skeleton ---------- */
    grid.querySelectorAll(".img-wrap img").forEach(img => {
        const done = () => {
            img.classList.add("loaded");
            img.parentElement.style.animation = "none";
        };
        img.complete ? done() : img.addEventListener("load", done);
        img.addEventListener("error", done);
    });

    /* ---------- filter + search ---------- */
    function applyFilters() {
        let visibleCount = 0;
        cards.forEach(card => {
            const matchCat = activeFilter === "all" || card.dataset.category === activeFilter;
            const matchQ   = !query || card.dataset.search.includes(query);
            const show = matchCat && matchQ;
            card.classList.toggle("hidden", !show);
            if (show) {
                visibleCount++;
                card.classList.add("visible");
            }
        });
        noResults.style.display = visibleCount ? "none" : "block";
    }

    chips.forEach(chip => {
        chip.addEventListener("click", () => {
            chips.forEach(c => c.classList.remove("active"));
            chip.classList.add("active");
            chip.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
            activeFilter = chip.dataset.filter;
            applyFilters();
        });
    });

    let searchTimer;
    searchEl.addEventListener("input", () => {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(() => {
            query = searchEl.value.trim().toLowerCase();
            applyFilters();
        }, 150);
    });

    document.getElementById("resetFilters").addEventListener("click", () => {
        searchEl.value = "";
        query = "";
        activeFilter = "all";
        chips.forEach(c => c.classList.toggle("active", c.dataset.filter === "all"));
        applyFilters();
    });

    /* ---------- GST toggle: actually shows the total price ---------- */
    const fmt = n => "\u20B9" + Math.round(n).toLocaleString("en-IN");
    taxSwitch.addEventListener("change", () => {
        const on = taxSwitch.checked;
        grid.classList.toggle("show-tax", on);
        grid.querySelectorAll(".price-value").forEach(el => {
            const base = Number(el.dataset.price);
            el.textContent = fmt(on ? base * 1.18 : base);
        });
        toast(on ? "Showing prices incl. 18% GST" : "Showing base prices");
    });

    /* ---------- wishlist (saved in localStorage) ---------- */
    const KEY = "wishlist";
    const getSaved = () => { try { return JSON.parse(localStorage.getItem(KEY)) || []; } catch { return []; } };
    const setSaved = (list) => localStorage.setItem(KEY, JSON.stringify(list));

    function paintHeart(btn, active) {
        btn.classList.toggle("active", active);
        btn.querySelector("i").className = active ? "fa-solid fa-heart" : "fa-regular fa-heart";
    }

    const saved = new Set(getSaved());
    grid.querySelectorAll(".wish-btn").forEach(btn => {
        paintHeart(btn, saved.has(btn.dataset.id));

        btn.addEventListener("click", (e) => {
            e.preventDefault();      // don't follow the card link
            e.stopPropagation();
            const id = btn.dataset.id;
            const nowActive = !saved.has(id);
            nowActive ? saved.add(id) : saved.delete(id);
            setSaved([...saved]);
            paintHeart(btn, nowActive);
            btn.classList.remove("pop"); void btn.offsetWidth; btn.classList.add("pop");
            toast(nowActive ? "Saved to wishlist" : "Removed from wishlist");
        });
    });

    /* ---------- toolbar shadow when stuck ---------- */
    const onScroll = () => toolbar.classList.toggle("stuck", window.scrollY > 80);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    /* ---------- horizontal scroll with mouse wheel on filters ---------- */
    const filtersEl = document.getElementById("filters");
    filtersEl.addEventListener("wheel", (e) => {
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
            e.preventDefault();
            filtersEl.scrollLeft += e.deltaY;
        }
    }, { passive: false });
})();
</script>
