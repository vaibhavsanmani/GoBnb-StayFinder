<% layout("/layouts/boilerplate") %>

<style>
:root{
    --primary:#ff385c;
    --dark:#222;
    --light:#f8f9fa;
}

.hero{
    min-height:75vh;
    display:flex;
    align-items:center;
    background:linear-gradient(
    135deg,
    rgba(255,56,92,.08),
    rgba(255,255,255,1));
}

.hero-title{
    font-size:3rem;
    font-weight:800;
    color:var(--dark);
}

.hero-title span{
    color:var(--primary);
}

.hero-text{
    font-size:1.1rem;
    color:#666;
}

.hero-img{
    width:100%;
    max-width:500px;
}

.section-title{
    font-weight:700;
    margin-bottom:15px;
}

.feature-card{
    background:white;
    border:none;
    border-radius:20px;
    padding:25px;
    text-align:center;
    box-shadow:0 10px 25px rgba(0,0,0,.08);
    transition:.3s;
    height:100%;
}

.feature-card:hover{
    transform:translateY(-8px);
}

.feature-icon{
    width:70px;
    height:70px;
    display:flex;
    align-items:center;
    justify-content:center;
    margin:auto;
    border-radius:50%;
    background:rgba(255,56,92,.12);
    color:var(--primary);
    font-size:28px;
    margin-bottom:15px;
}

.stats{
    background:var(--primary);
    color:white;
    border-radius:30px;
    padding:50px 20px;
}

.stat-number{
    font-size:2.5rem;
    font-weight:800;
}

.team-card{
    border:none;
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 10px 25px rgba(0,0,0,.08);
}

.team-card img{
    height:250px;
    object-fit:cover;
}

.cta{
    background:linear-gradient(
    135deg,
    #ff385c,
    #ff6b81);
    color:white;
    border-radius:30px;
    padding:60px 20px;
}

.cta .btn{
    border-radius:30px;
    padding:12px 28px;
    font-weight:600;
}

@media(max-width:768px){

.hero{
    text-align:center;
    padding:50px 0;
}

.hero-title{
    font-size:2.2rem;
}

.hero-img{
    margin-top:30px;
}

.stat-number{
    font-size:2rem;
}

}
</style>

<!-- HERO -->
<section class="hero">
<div class="container">
<div class="row align-items-center">

<div class="col-lg-6">
<h1 class="hero-title">
Discover Your Next Stay with
<span>GoBnb</span>
</h1>

<p class="hero-text mt-3">
GoBnb helps travelers discover unique stays,
beautiful homes, and unforgettable experiences
around the world. Whether you're planning a
weekend getaway or a long vacation,
we make finding the perfect place simple.
</p>

<a href="/listings" class="btn btn-danger btn-lg mt-3 rounded-pill px-4">
Explore Stays
</a>
</div>

<div class="col-lg-6 text-center">
<img
src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=900"
class="hero-img img-fluid rounded-4 shadow-lg">
</div>

</div>
</div>
</section>

<!-- FEATURES -->
<section class="py-5">
<div class="container">

<div class="text-center mb-5">
<h2 class="section-title">Why Choose GoBnb?</h2>
<p class="text-muted">
Everything you need for a smooth booking experience.
</p>
</div>

<div class="row g-4">

<div class="col-md-4">
<div class="feature-card">
<div class="feature-icon">
<i class="fa-solid fa-house"></i>
</div>
<h5>Unique Stays</h5>
<p class="text-muted">
Find apartments, villas, cabins, beach houses and more.
</p>
</div>
</div>

<div class="col-md-4">
<div class="feature-card">
<div class="feature-icon">
<i class="fa-solid fa-location-dot"></i>
</div>
<h5>Verified Locations</h5>
<p class="text-muted">
Explore destinations with map integration and details.
</p>
</div>
</div>

<div class="col-md-4">
<div class="feature-card">
<div class="feature-icon">
<i class="fa-solid fa-star"></i>
</div>
<h5>Trusted Reviews</h5>
<p class="text-muted">
Read authentic reviews before making your booking.
</p>
</div>
</div>

</div>
</div>
</section>

<!-- STATS -->
<section class="container my-5">
<div class="stats">

<div class="row text-center">

<div class="col-4">
<div class="stat-number">500+</div>
<p>Listings</p>
</div>

<div class="col-4">
<div class="stat-number">50+</div>
<p>Cities</p>
</div>

<div class="col-4">
<div class="stat-number">1K+</div>
<p>Users</p>
</div>

</div>

</div>
</section>

<!-- TEAM -->
<section class="py-5">
<div class="container">

<div class="text-center mb-5">
<h2 class="section-title">Meet The Creator</h2>
</div>

<div class="row justify-content-center">

<div class="col-md-5">

<div class="card team-card">

<img
src="/images/vaibhav1.jpeg">

<div class="card-body text-center">

<h4>Vaibhav Sanmani</h4>

<p class="text-muted">
Computer Engineering Student,
Web Developer and Creator of GoBnb.
Passionate about building modern web applications
that solve real-world problems.
</p>

</div>

</div>

</div>

</div>

</div>
</section>

<!-- CTA -->
<section class="container my-5">
<div class="cta text-center">

<h2 class="fw-bold mb-3">
Ready for your next adventure?
</h2>

<p class="mb-4">
Explore amazing destinations and find your perfect stay today.
</p>

<a href="/listings" class="btn btn-light">
Browse Listings
</a>

</div>
</section>